# ── KAYAR backend configuration ───────────────────────────────────────────────
# Copy to `server/.env` (git-ignored) and fill in the real values.
PORT=8787
KAYAR_DB=server/kayar.db
KAYAR_APP_URL=https://app.kayar.ir          # public base URL of this server
KAYAR_CORS=*                                 # or: https://kapoosh.ir,https://app.kayar.ir

# ── AI: NaraRouter (OpenAI-compatible gateway) ────────────────────────────────
NARAROUTER_API_KEY=sk-nry-xxxxxxxx
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_ALLOW_PAID=0                      # 1 = also use pay-as-you-go models (needs credit)
NARAROUTER_TIMEOUT_MS=60000

# ── first super-admin (created once, on an empty database) ────────────────────
ZITE_BOOTSTRAP_ADMIN_USERNAME=admin
ZITE_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong
ZITE_AUTH_PEPPER=replace-with-32-random-chars

# ── optional integrations ─────────────────────────────────────────────────────
ZITE_JAMENDO_CLIENT_ID=                      # live music in «مرشد»

# ── payment gateway (one provider at a time) ─────────────────────────────────
PAY_PROVIDER=disabled                        # disabled | zarinpal | zibal | idpay | payir
PAY_CURRENCY=IRT                             # IRR (Rial) or IRT (Toman)
PAY_CALLBACK_BASE=https://app.kayar.ir        # registered callback host (https + domain)
PAY_SANDBOX=0
ZARINPAL_MERCHANT_ID=
ZIBAL_MERCHANT=
IDPAY_API_KEY=
PAYIR_API_KEY=
KAPOOSH_WEBHOOK_SECRET=                      # HMAC secret shared with kapoosh.ir checkout
